    {
      "cell_type": "code",
      "source": [
        "import cv2\n",
        "\n",
        "def show_images(folder, title):\n",
        "    plt.figure(figsize=(8,8))\n",
        "    images = os.listdir(folder)\n",
        "\n",
        "    for i in range(6):\n",
        "        img = cv2.imread(os.path.join(folder, images[i]))\n",
        "        img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)\n",
        "\n",
        "        plt.subplot(2,3,i+1)\n",
        "        plt.imshow(img)\n",
        "        plt.axis(\"off\")\n",
        "\n",
        "    plt.suptitle(title)\n",
        "    plt.show()"
      ],
      "metadata": {
        "id": "4AV9PvjtKSEq"
      },
      "execution_count": 12,
      "outputs": []
    },
