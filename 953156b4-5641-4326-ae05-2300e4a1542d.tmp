    {
      "cell_type": "code",
      "execution_count": 15,
      "metadata": {
        "id": "FVNzVCd3mxQA"
      },
      "outputs": [],
      "source": [
        "from tensorflow.keras import layers, models\n",
        "\n",
        "cnn_model = models.Sequential([\n",
        "    layers.Conv2D(32, 3, activation='relu', input_shape=(224,224,3)),\n",
        "    layers.MaxPooling2D(),\n",
        "\n",
        "    layers.Conv2D(64, 3, activation='relu'),\n",
        "    layers.MaxPooling2D(),\n",
        "\n",
        "    layers.Conv2D(128, 3, activation='relu'),\n",
        "    layers.MaxPooling2D(),\n",
        "\n",
        "    layers.Flatten(),\n",
        "    layers.Dense(128, activation='relu'),\n",
        "    layers.Dropout(0.5),\n",
        "    layers.Dense(1, activation='sigmoid')\n",
        "])\n",
        "\n",
        "cnn_model.compile(optimizer='adam',\n",
        "                  loss='binary_crossentropy',\n",
        "                  metrics=['accuracy'])"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 16,
      "metadata": {
        "id": "3khyebhxmyKP"
      },
      "outputs": [],
      "source": [
        "from tensorflow.keras.applications import MobileNetV2\n",
        "\n",
        "base1 = MobileNetV2(weights='imagenet',\n",
        "                     include_top=False,\n",
        "                     input_shape=(224,224,3))\n",
        "\n",
        "base1.trainable = False\n",
        "\n",
        "mobilenet_model = tf.keras.Sequential([\n",
        "    base1,\n",
        "    layers.GlobalAveragePooling2D(),\n",
        "    layers.Dense(128, activation='relu'),\n",
        "    layers.Dropout(0.5),\n",
        "    layers.Dense(1, activation='sigmoid')\n",
        "])\n",
        "\n",
        "mobilenet_model.compile(optimizer='adam',\n",
        "                        loss='binary_crossentropy',\n",
        "                        metrics=['accuracy'])"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "kHT0EkaDm08z",
        "outputId": "d5b6af7d-5fe6-4c54-ba62-4918f8e85f8c"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Epoch 1/5\n",
            "\u001b[1m  3/163\u001b[0m \u001b[37m━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[1m39:51\u001b[0m 15s/step - accuracy: 0.4271 - loss: 1.1273"
          ]
        }
      ],
      "source": [
        "cnn_history = cnn_model.fit(\n",
        "    train_data,\n",
        "    validation_data=val_data,\n",
        "    epochs=5\n",
        ")\n",
        "\n",
        "mob_history = mobilenet_model.fit(\n",
        "    train_data,\n",
        "    validation_data=val_data,\n",
        "    epochs=5\n",
        ")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "duWaxu-Pm6nf"
      },
      "outputs": [],
      "source": [
        "cnn_loss, cnn_acc = cnn_model.evaluate(test_data)\n",
        "mob_loss, mob_acc = mobilenet_model.evaluate(test_data)\n",
        "\n",
        "print(\"CNN Test Accuracy:\", cnn_acc)\n",
        "print(\"MobileNet Test Accuracy:\", mob_acc)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "cP9dFVFZm_JP"
      },
      "outputs": [],
      "source": [
        "import matplotlib.pyplot as plt\n",
        "\n",
        "models = [\"CNN\", \"MobileNet\"]\n",
        "acc = [cnn_acc, mob_acc]\n",
        "\n",
        "plt.bar(models, acc)\n",
        "plt.title(\"Model Comparison (Realistic)\")\n",
        "plt.ylim(0, 1)\n",
        "plt.show()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "IZbl80DZnBs-"
      },
      "outputs": [],
      "source": [
        "import numpy as np\n",
        "from tensorflow.keras.preprocessing import image\n",
        "\n",
        "def predict(model, img_path):\n",
        "    img = image.load_img(img_path, target_size=(224,224))\n",
        "    img = image.img_to_array(img)/255.0\n",
        "    img = np.expand_dims(img, axis=0)\n",
        "\n",
        "    pred = model.predict(img)[0][0]\n",
        "\n",
        "    # threshold مش ثابت\n",
        "    return \"PNEUMONIA ❌\" if pred > 0.4 else \"NORMAL ✅\""
      ]
    },
